# ==============================================================================
# FRONTEND DASHBOARD - ENVIRONMENT CONFIGURATION
# ==============================================================================
# When running locally:
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#
# When deploying to Vercel / Netlify / Render:
#   Set this to your live backend URL (e.g., https://fraud-investigation-backend.onrender.com)
NEXT_PUBLIC_API_URL=https://fraud-investigation-backend.onrender.com

# Optional: If you set API_KEY on the backend, set the same value here
NEXT_PUBLIC_API_KEY=

# ==============================================================================
# AUTONOMOUS FRAUD INVESTIGATION - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env:
#   Local (PowerShell): copy .env.example .env
#   Local (Bash):       cp .env.example .env
#
# When deploying to Render, Vercel, Railway, etc., set these in the dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM CONFIGURATION (Optional - falls back to deterministic rule engine)
# ------------------------------------------------------------------------------
# Leave empty to run the fast deterministic rule-based investigation engine.
# Set an Anthropic API key to enable Claude-powered autonomous planning & reasoning.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL or SQLite)
# ------------------------------------------------------------------------------
# Local Docker:
# DATABASE_URL=postgresql+psycopg2://fraud:fraudpass@postgres:5432/frauddb
#
# Local SQLite (no docker):
# DATABASE_URL=sqlite:///./fraud.db
#
# Cloud Deployment (Render PostgreSQL / Neon.tech / Supabase):
# Provide the full connection string (both postgres:// and postgresql:// are supported)
# e.g.: postgresql://frauddb_user:password@ep-cool-sample.us-east-2.aws.neon.tech/frauddb?sslmode=require
DATABASE_URL=sqlite:///./fraud.db

# ------------------------------------------------------------------------------
# 3. GRAPH DATABASE CONFIGURATION (Neo4j)
# ------------------------------------------------------------------------------
# If Neo4j is not reachable or empty, the backend automatically uses its
# built-in In-Memory Graph fallback without crashing.
#
# Local Docker:
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=fraudgraph
#
# Local Desktop:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=fraudgraph
#
# Cloud Deployment (Neo4j AuraDB Free - https://neo4j.com/cloud/platform/aura-graph-database/):
# NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<your-auradb-password>
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fraudgraph

# ------------------------------------------------------------------------------
# 4. API AUTH & SECURITY (Optional in dev, recommended in production)
# ------------------------------------------------------------------------------
# If API_KEY is left empty, endpoints are open (dev mode).
# If set, all protected endpoints require the header `X-API-Key: <value>`.
API_KEY=
WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Use "*" to allow all (e.g. Vercel preview URLs).
# Example: https://fraud-dashboard.vercel.app,http://localhost:3000
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 6. DECISION THRESHOLDS
# ------------------------------------------------------------------------------
FRAUD_BLOCK_THRESHOLD=0.8
FRAUD_REVIEW_THRESHOLD=0.5
